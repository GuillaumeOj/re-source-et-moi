# Copy to backend/.env for local (non-Docker) runs. Docker Compose sets these itself.
DEBUG=1
SECRET_KEY=dev-only-secret-change-me
# Local Postgres (matches docker-compose). In production, set this to Neon's POOLED URL.
DATABASE_URL=postgres://rsm:rsm@localhost:5445/rsm
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# The Next dev server's origin. In production the two are same-origin behind one Vercel
# domain, so this is a local-development concern only.
CORS_ALLOWED_ORIGINS=http://localhost:3001
# Keep 0 on serverless (Vercel); a small positive value is fine for a long-lived container.
CONN_MAX_AGE=0
# The secret URL segment the Django admin is mounted at. Required on Vercel (no default →
# startup fails if it's missing); local dev falls back to "admin".
# ADMIN_PATH=admin
# The editor's full URL, secret path included. Password-reset e-mails link here. Required
# on Vercel; local dev falls back to http://localhost:3001/admin-local.
# EDITOR_URL=http://localhost:3001/admin-local
# Brevo transactional API key and a sender verified in Brevo. Both required on Vercel.
# Locally, leave the key unset and reset e-mails are printed to the Django console.
# BREVO_API_KEY=
# DEFAULT_FROM_EMAIL=Re-Source Et Moi <contact@re-source-et-moi.fr>
