# The repo holds two stacks (frontend/ Next.js, backend/ Django), so these patterns are
# deliberately un-anchored: they must match at either root.

# dependencies
node_modules/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env*
!.env.example

# vercel
.vercel

# claude code (local, machine-specific settings; worktrees are scratch checkouts)
.claude/settings.local.json
.claude/worktrees/

# typescript
*.tsbuildinfo
next-env.d.ts

# testing
coverage/

# python / django
.venv/
.tox/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
backend/staticfiles/
