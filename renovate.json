{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Paris",
  "schedule": ["before 6am on monday"],
  "rangeStrategy": "pin",
  "labels": ["dependencies"],
  "prHourlyLimit": 0,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "One weekly PR for the non-major backend (uv) updates.",
      "matchFileNames": ["backend/**"],
      "matchManagers": ["pep621"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "backend dependencies"
    },
    {
      "description": "One weekly PR for the non-major frontend (bun) updates.",
      "matchFileNames": ["frontend/**"],
      "matchManagers": ["bun", "npm"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "frontend dependencies"
    },
    {
      "description": "One weekly PR for the non-major GitHub Actions and Docker image updates (backend/ and frontend/ Dockerfiles included).",
      "matchManagers": ["github-actions", "dockerfile", "docker-compose"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "CI & Docker images"
    },
    {
      "description": "Codegen tools can change the generated schema.yml / generated.ts, which fails CI until regenerated by hand: keep them out of the groups, one PR each.",
      "matchPackageNames": ["drf-spectacular", "openapi-typescript"],
      "groupName": null
    },
    {
      "description": "The Python runtime moves 3.13 -> 3.14 by hand (.python-version, requires-python, Dockerfile, CI, ruff/ty targets together): Renovate never bumps it.",
      "matchDepNames": ["python"],
      "enabled": false
    },
    {
      "description": "Same, for the .python-version file.",
      "matchManagers": ["pyenv"],
      "enabled": false
    }
  ]
}
